{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-1234-56789abcdef0",
		"name": "NewApp Notifications API",
		"description": "API Endpoints for handling in-app notifications and Firebase Cloud Messaging (FCM)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "FCM - Push Notifications",
			"item": [
				{
					"name": "Save FCM Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fcm_token\": \"YOUR_DEVICE_FCM_TOKEN_HERE\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/fcm-token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"fcm-token"
							]
						}
					}
				},
				{
					"name": "Send Test Push Notification",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/send-test-notification",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"send-test-notification"
							]
						}
					}
				},
				{
					"name": "Send Custom Admin Notification",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Breaking News\",\n    \"body\": \"A major event has occurred!\",\n    \"data\": {\n        \"news_id\": \"123\"\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/send-notification",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"send-notification"
							]
						}
					}
				}
			]
		},
		{
			"name": "In-App Notifications",
			"item": [
				{
					"name": "Get All Notifications",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/notifications",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"notifications"
							]
						}
					}
				},
				{
					"name": "Get Unread Count",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/notifications/unread-count",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"notifications",
								"unread-count"
							]
						}
					}
				},
				{
					"name": "Mark as Read",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/notifications/:id/mark-as-read",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"notifications",
								":id",
								"mark-as-read"
							],
							"variable": [
								{
									"key": "id",
									"value": "uuid-of-the-notification-here"
								}
							]
						}
					}
				},
				{
					"name": "Mark All as Read",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/notifications/mark-all-as-read",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"notifications",
								"mark-all-as-read"
							]
						}
					}
				}
			]
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{bearer_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "bearer_token",
			"value": "your-auth-token-here",
			"type": "string"
		}
	]
}
